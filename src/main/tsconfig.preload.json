{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../../build/main/preload",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["channels.ts", "preload.ts"],
  "exclude": ["node_modules"]
}
