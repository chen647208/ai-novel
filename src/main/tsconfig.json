{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../../build/main",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["channels.ts", "logger.ts", "vector-ipc.ts", "sqlite-ipc.ts", "main.ts", "app/**/*.ts"],
  "exclude": ["node_modules"]
}
