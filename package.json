{
  "name": "novalocal-ai-novelist",
  "private": true,
  "version": "1.0.0",
  "description": "本地优先的 AI 小说创作助手：书籍管理、灵感生成、人物构建、大纲设计、章节规划、知识库与正文写作。",
  "author": "NovaLocal",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/chen647208/ai-novel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen647208/ai-novel.git"
  },
  "keywords": [
    "electron",
    "ai",
    "novel",
    "writing",
    "local-first",
    "小说",
    "创作"
  ],
  "type": "module",
  "main": "build/main/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "node scripts/sync-docs.mjs && vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build:electron": "npm run build:electron:main && npm run build:electron:preload",
    "build:electron:main": "tsc -p src/main/tsconfig.json",
    "build:electron:preload": "esbuild src/main/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=build/main/preload/preload.js",
    "electron:build": "npm run build && npm run build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:main": "tsc --noEmit -p src/main/tsconfig.json && tsc --noEmit -p src/main/tsconfig.preload.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:main",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "headers": "node scripts/add-license-headers.mjs",
    "headers:check": "node scripts/add-license-headers.mjs --check",
    "release:bump": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:icons": "node scripts/check-win-icon.cjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "preverify": "npm ci --dry-run --no-audit --no-fund --loglevel=error",
    "verify": "npm run lint && npm run typecheck:all && npm run test:coverage && npm run headers:check && npm run scan:secrets && npm run electron:build",
    "dist": "npm run electron:build && electron-builder",
    "dist:win": "npm run electron:build && electron-builder --win",
    "dist:mac": "npm run electron:build && electron-builder --mac",
    "dist:linux": "npm run electron:build && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@google/genai": "^1.34.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-select": "^2.2.6",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tiptap/core": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@uiw/react-codemirror": "^4.25.11",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^4.1.0",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^8.10.2",
    "vectra": "^0.12.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.23",
    "chromadb": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.40.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.3"
  }
}
